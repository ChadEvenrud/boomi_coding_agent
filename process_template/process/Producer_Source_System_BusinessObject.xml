><staticparameter staticproperty="&lt;InterfaceName&gt;"/></parametervalue></sourcevalues></documentproperty><documentproperty defaultValue="" isDynamicCredential="false" isTradingPartner="false" name="Dynamic Process Property - DPP_ResponseType" persist="false" propertyId="process.DPP_ResponseType" shouldEncrypt="false"><sourcevalues><parametervalue key="19" valueType="static"><staticparameter staticproperty="xml"/></parametervalue></sourcevalues></documentproperty><documentproperty defaultValue="" isDynamicCredential="false" isTradingPartner="false" name="Dynamic Process Property - DPP_OriginalPayload" persist="false" propertyId="process.DPP_OriginalPayload" shouldEncrypt="false"><sourcevalues><parametervalue key="24" valueType="current"/></sourcevalues></documentproperty><documentproperty defaultValue="" isDynamicCredential="false" isTradingPartner="false" name="Dynamic Process Property - DPP_ProcessName" persist="false" propertyId="process.DPP_ProcessName" shouldEncrypt="false"><sourcevalues><parametervalue key="26" valueType="execution"><executionparameter executionproperty="Process Name"/></parametervalue></sourcevalues></documentproperty><documentproperty defaultValue="" isDynamicCredential="false" isTradingPartner="false" name="Dynamic Process Property - DPP_BoomiExecutionID" persist="false" propertyId="process.DPP_BoomiExecutionID" shouldEncrypt="false"><sourcevalues><parametervalue key="27" valueType="execution"><executionparameter executionproperty="Execution Id"/></parametervalue></sourcevalues></documentproperty></documentproperties></configuration><dragpoints><dragpoint name="shape35.dragpoint1" toShape="shape2" x="416.0" y="56.0"/></dragpoints></shape><shape image="dataprocess_icon" name="shape37" shapetype="dataprocess" userlabel="" x="960.0" y="96.0"><configuration><dataprocess><step index="1" key="1" name="Custom Scripting" processtype="12"><dataprocessscript language="groovy" useCache="true"><script>import java.util.Properties&#xD;
import java.util.Random&#xD;
&#xD;
Random random = new Random()&#xD;
&#xD;
String getValue(String json, String fieldName) {&#xD;
    def matcher = json =~ /"${fieldName}"\s*:\s*("[^"]*"|null|-?\d+)/&#xD;
    if (matcher.find()) {&#xD;
        return matcher.group(1)&#xD;
    }&#xD;
    return null&#xD;
}&#xD;
&#xD;
Integer getIntValue(String json, String fieldName) {&#xD;
    String value = getValue(json, fieldName)&#xD;
&#xD;
    if (value == null || value == "null") {&#xD;
        return 0&#xD;
    }&#xD;
&#xD;
    value = value.replace("\"", "")&#xD;
    return value as Integer&#xD;
}&#xD;
&#xD;
String setNumberValue(String json, String fieldName, Integer newValue) {&#xD;
    String pattern = /"${fieldName}"\s*:\s*("[^"]*"|null|-?\d+)/&#xD;
    return json.replaceFirst(pattern, "\"" + fieldName + "\": " + newValue)&#xD;
}&#xD;
&#xD;
String setNullValue(String json, String fieldName) {&#xD;
    String pattern = /"${fieldName}"\s*:\s*("[^"]*"|null|-?\d+)/&#xD;
    return json.replaceFirst(pattern, "\"" + fieldName + "\": null")&#xD;
}&#xD;
&#xD;
String removeField(String json, String fieldName) {&#xD;
    // Removes field whether it has trailing comma or leading comma&#xD;
    json = json.replaceFirst(/,\s*"${fieldName}"\s*:\s*("[^"]*"|null|-?\d+)/, "")&#xD;
    json = json.replaceFirst(/"${fieldName}"\s*:\s*("[^"]*"|null|-?\d+)\s*,/, "")&#xD;
    return json&#xD;
}&#xD;
&#xD;
for (int i = 0; i &lt; dataContext.getDataCount(); i++) {&#xD;
&#xD;
    InputStream is = dataContext.getStream(i)&#xD;
    Properties props = dataContext.getProperties(i)&#xD;
&#xD;
    String json = is.getText("UTF-8")&#xD;
&#xD;
    Integer originalTotalLength = getIntValue(json, "TOTAL_LENGTH")&#xD;
    Integer originalBoardsLayer = getIntValue(json, "BOARDS_LAYER")&#xD;
    Integer originalBoardCount = getIntValue(json, "BOARD_COUNT")&#xD;
    Integer originalLayersPack = getIntValue(json, "LAYERS_PACK")&#xD;
    Integer originalBoardsTopLayer = getIntValue(json, "BOARDS_TOP_LAYER")&#xD;
    Integer originalShortBoardLength = getIntValue(json, "SHORT_BOARD_LENGTH")&#xD;
    Integer originalLongBoardLength = getIntValue(json, "LONG_BOARD_LENGTH")&#xD;
&#xD;
    Boolean isFullyConsumed = random.nextBoolean()&#xD;
&#xD;
    if (isFullyConsumed) {&#xD;
&#xD;
        // Complete / consumed&#xD;
        json = setNumberValue(json, "REASON", 4)&#xD;
&#xD;
        json = setNumberValue(json, "TOTAL_LENGTH", 0)&#xD;
        json = setNumberValue(json, "TOTAL_USABLE_LENGTH", 0)&#xD;
        json = setNumberValue(json, "BOARDS_LAYER", 0)&#xD;
        json = setNumberValue(json, "BOARD_COUNT", 0)&#xD;
        json = setNumberValue(json, "LAYERS_PACK", 0)&#xD;
        json = setNumberValue(json, "BOARDS_TOP_LAYER", 0)&#xD;
        json = setNumberValue(json, "SHORT_BOARD_LENGTH", 0)&#xD;
        json = setNumberValue(json, "LONG_BOARD_LENGTH", 0)&#xD;
&#xD;
    } else {&#xD;
&#xD;
        // Partial / remaining material&#xD;
        json = setNumberValue(json, "REASON", 3)&#xD;
&#xD;
        Integer remainingPercent = random.nextInt(66) + 10&#xD;
&#xD;
        Integer newTotalLength = Math.max(1, ((originalTotalLength * remainingPercent) / 100) as Integer)&#xD;
        Integer newBoardsLayer = Math.max(1, ((originalBoardsLayer * remainingPercent) / 100) as Integer)&#xD;
        Integer newBoardCount = Math.max(1, ((originalBoardCount * remainingPercent) / 100) as Integer)&#xD;
        Integer newLayersPack = Math.max(1, ((originalLayersPack * remainingPercent) / 100) as Integer)&#xD;
        Integer newBoardsTopLayer = Math.max(1, ((originalBoardsTopLayer * remainingPercent) / 100) as Integer)&#xD;
        Integer newShortBoardLength = Math.max(1, ((originalShortBoardLength * remainingPercent) / 100) as Integer)&#xD;
        Integer newLongBoardLength = Math.max(newShortBoardLength, ((originalLongBoardLength * remainingPercent) / 100) as Integer)&#xD;
&#xD;
        json = setNumberValue(json, "TOTAL_LENGTH", newTotalLength)&#xD;
        json = setNumberValue(json, "BOARDS_LAYER", newBoardsLayer)&#xD;
        json = setNumberValue(json, "BOARD_COUNT", newBoardCount)&#xD;
        json = setNumberValue(json, "LAYERS_PACK", newLayersPack)&#xD;
        json = setNumberValue(json, "BOARDS_TOP_LAYER", newBoardsTopLayer)&#xD;
        json = setNumberValue(json, "SHORT_BOARD_LENGTH", newShortBoardLength)&#xD;
        json = setNumberValue(json, "LONG_BOARD_LENGTH", newLongBoardLength)&#xD;
    }&#xD;
&#xD;
    // Remove auto-increment key before insert into DATA_PACK_COMPLETED&#xD;
    json = removeField(json, "TRANS_NR")&#xD;
&#xD;
    json = setNumberValue(json, "PROCESSING_STATUS", 1)&#xD;
    json = setNullValue(json, "PROCESSING_TEXT")&#xD;
    json = setNullValue(json, "PROCESSING_TIME")&#xD;
&#xD;
    dataContext.storeStream(&#xD;
        new ByteArrayInputStream(json.getBytes("UTF-8")),&#xD;
        props&#xD;
    )&#xD;
}</script></dataprocessscript></step></dataprocess></configuration><dragpoints><dragpoint name="shape37.dragpoint1" toShape="shape36" x="1136.0" y="104.0"/></dragpoints></shape><shape image="message_icon" name="shape36" shapetype="message" userlabel="" x="1152.0" y="96.0"><configuration><message combined="false"><msgTxt/><msgParameters/></message></configuration><dragpoints><dragpoint name="shape36.dragpoint1" toShape="unset" x="1284.0" y="106.0"/></dragpoints></shape><shape image="connectoraction_icon" name="shape38" shapetype="connectoraction" userlabel="" x="704.0" y="96.0"><configuration><connectoraction actionType="GET" allowDynamicCredentials="NONE" connectionId="2c2662a4-c95e-41aa-8f00-381648c07f86" connectorType="officialboomi-X3979C-dbv2da-prod" hideSettings="false" operationId="3654d5cb-e25d-41d2-a447-d2ce06174419"><parameters/><dynamicProperties/></connectoraction></configuration><dragpoints><dragpoint name="shape38.dragpoint1" toShape="shape37" x="944.0" y="104.0"/></dragpoints></shape></shapes></process></bns:object><bns:processOverrides/></bns:Component>